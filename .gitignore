# ─── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── Editors ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.env

# ─── Vector DB (generated by ingest.py) ───────────────────────────────────────
chroma_db/

# ─── Function build artifacts (applies to any function subfolder) ─────────────
functions/*/node_modules/
functions/*/build/
functions/*/dist/
functions/*/.spin/
functions/*/.spin-aka/

# ─── Existing sample functions (generated by the owner, not part of the template)
functions/dummyjson-auth-proxy/
functions/dummyjson-bot-misdirection/
functions/dummyjson-proxy/
functions/echo-request/
functions/html-modifier/
functions/swedish-tutor/

# Out-of-scope side projects
frontend/
.github/skills/

# ─── Ingestion tooling (out of scope for v1) ──────────────────────────────────
ingest.py
config.py
CODEGEN_REFERENCE_PROMPT.md
COMPILE_PROMPT.md
docs/index.json

# Supporting tools and tests
scripts/
tests/
benchmarks/

# The dependency-free reference synchronization workflow is part of the
# distributable project. Other local/legacy supporting files remain ignored.
!scripts/
scripts/*
!scripts/reference_sync.py
!scripts/sync_agent_instructions.py
!tests/
tests/*
!tests/test_agent_instructions.py
!tests/test_reference_sync.py
