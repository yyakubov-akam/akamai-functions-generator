# ─── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── Editors ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.env

# ─── Vector DB (generated by ingest.py) ───────────────────────────────────────
chroma_db/

# ─── Function build artifacts (applies to any function subfolder) ─────────────
functions/*/node_modules/
functions/*/build/
functions/*/dist/
functions/*/.spin/
functions/*/.spin-aka/

# ─── Existing sample functions (generated by the owner, not part of the template)
functions/dummyjson-auth-proxy/
functions/dummyjson-bot-misdirection/
functions/dummyjson-proxy/
functions/echo-request/
functions/html-modifier/
functions/swedish-tutor/

# Out-of-scope side projects
frontend/
.github/skills/

# ─── Private local documentation workflow ─────────────────────────────────────
# These files remain available in the owner's working copy but are intentionally
# excluded from the public repository. CI also rejects them if force-added.
ingest.py
ingest_v2.py
config.py
change_detection.py
markdown_source.py
CODEGEN_REFERENCE_PROMPT.md
COMPILE_PROMPT.md
LOCAL_WORKFLOW.md
docs/index.json
docs/techdocs-akamai-com/
tests/test_change_detection.py
tests/test_markdown_source.py
requirements-local.txt

# Supporting tools and tests
scripts/
tests/
benchmarks/

# The dependency-free reference synchronization workflow is part of the
# distributable project. Other local/legacy supporting files remain ignored.
!scripts/
scripts/*
!scripts/reference_sync.py
!scripts/check_public_boundary.py
!scripts/sync_agent_instructions.py
!tests/
tests/*
!tests/test_agent_instructions.py
!tests/test_public_boundary.py
!tests/test_reference_sync.py
